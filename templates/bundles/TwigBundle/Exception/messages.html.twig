{% trans_default_domain 'exception' %}

{% set status_code = status_code is defined ? status_code : 'Erreur'|trans %}

<h2 class="h1 ff-primary">{{ status_code|raw }}</h2>

{% if status_code == 404 %}
    <h2 class="mb-3 ff-primary">{{ "Cette page est introuvable"|trans|raw }}</h2>
    <p class="message">{{ "La page que vous recherchez n'est plus disponible ou a été déplacée. Laissez-nous vous raccompagner vers l'accueil."|trans|raw }}</p>
{% elseif status_code == 401 %}
    <h2 class="mb-3 ff-primary">{{ "Accès non autorisé"|trans|raw }}</h2>
    <p class="message">{{ "Cette page ne vous est pas accessible."|trans|raw }}</p>
{% elseif status_code == 403 %}
    <h2 class="mb-3 ff-primary">{{ "Accès non autorisé"|trans|raw }}</h2>
    {% if granted('ROLE_INTERNAL') %}
        <p class="text-danger fw-300 message">{{ exception.message }}</p>
    {% endif %}
{% else %}
    <h2 class="mb-3 ff-primary">{{ "Une erreur est survenue"|trans|raw }}</h2>
    {% if granted('ROLE_INTERNAL') and exception.message is defined %}
        <p class="text-danger fw-300 message">{{ exception.message }}</p>
    {% endif %}
{% endif %}