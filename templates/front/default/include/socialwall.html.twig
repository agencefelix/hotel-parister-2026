{% trans_default_domain 'front_default' %}

{# Socialwall Parister : bande noire, 3 visuels Instagram portrait espacés + invitation à suivre. #}
{% set instaUrl = '#' %}
{% for name, infos in website.networks %}
    {% if name|lower == 'instagram' and infos.link %}
        {% set instaUrl = infos.link %}
    {% endif %}
{% endfor %}

<section id="socialwall" class="socialwall bg-light" aria-label="{{ "Mur social Instagram"|trans|striptags }}">
    <div class="container">
        <div class="socialwall-grid d-flex justify-content-between flex-wrap">
            {% set instaImages = [
                {file: 'cocktail-bar', alt: 'Cocktail rouge sur une table en marbre au bar du Parister'},
                {file: 'art-books', alt: "Pile de livres d'art Paris, Man Ray et Bauhaus dans le salon du Parister"},
                {file: 'easter-eggs', alt: 'Œufs de Pâques dorés décorés nichés dans le lierre'}
            ] %}
            {% for img in instaImages %}
                <a class="socialwall-link" href="{{ instaUrl }}"{% if instaUrl != '#' %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="Instagram - {{ "nouvelle fenêtre"|trans|striptags }}">
                    {{ asset('build/front/'~websiteTemplate~'/images/'~img.file~'.jpg', webpack)|file({}, {
                        screensSizes: {
                            mobile: {width: 220, height: 281},
                            tablet: {width: 320, height: 409},
                            desktop: {width: 320, height: 409}
                        },
                        alt: img.alt,
                        class: 'w-100 object-fit-cover'
                    }) }}
                </a>
            {% endfor %}
        </div>
        <div class="text-center mt-5">
            <a class="socialwall-follow btn btn-outline-primary text-uppercase" href="{{ instaUrl }}"{% if instaUrl != '#' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {{ "Suivez-nous sur insta"|trans|raw }}
            </a>
        </div>
    </div>
</section>
