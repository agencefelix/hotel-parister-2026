{% trans_default_domain 'front_default' %}

{# =========================================================================
   PRODUCT-VIEW dédié « chambres-suites » (maquette Parister) — NE PASSE PAS
   par le layout de catégorie. Résolu via ProductModel::getTemplate (template
   par slug de catalogue qui prime sur layout/default-product).
   3 blocs : (1) hero plein écran, (2) galerie + détails/accordéons + CTA,
   (3) « Les autres chambres » (slider de cards).
========================================================================= #}

{% set bookingUrl = entity.formPageUrl is defined and entity.formPageUrl ? entity.formPageUrl : path('front_index', {url: 'reservation'}) %}

{# Features groupées depuis l'entité brute (le ViewModel du view n'expose pas byFeaturesIds).
   adminName = label FR direct (Superficie, Équipements, Services inclus…). #}
{% set featureGroups = {} %}
{% set surfaceValue = null %}
{% if entity.entity is defined and entity.entity.values is defined %}
    {% for v in entity.entity.values %}
        {% set fname = v.feature is defined and v.feature ? v.feature.adminName : null %}
        {% set vlabel = v.value is defined and v.value ? v.value.adminName : null %}
        {% if fname and vlabel %}
            {% if fname == 'Superficie' %}
                {% set surfaceValue = vlabel %}
            {% else %}
                {% set list = featureGroups[fname] is defined ? featureGroups[fname] : [] %}
                {% if vlabel not in list %}
                    {% set featureGroups = featureGroups|merge({(fname): (list|merge([vlabel]))}) %}
                {% endif %}
            {% endif %}
        {% endif %}
    {% endfor %}
{% endif %}
{% set heroMedia = entity.mainMediaInHeader and entity.headerMedia ? entity.headerMedia : (entity.medias is not empty ? entity.medias|first : null) %}

{# ---------- 1) ENTÊTE : bloc title-header de base (titre kicker + script via <span> dans intl.title, baseline encadrée) ---------- #}
{% if entity.intl.title %}
    {% include 'front/'~websiteTemplate~'/blocks/title-header/default.html.twig' with {
        styleClass: 'product-header text-center',
        block: entity,
        customMedia: heroMedia,
        page: page is defined ? page : null,
        pageTitle: entity.intl.title,
        isIndex: true,
        titleForce: 1,
        baseline: entity.intl.placeholder is defined and entity.intl.placeholder ? entity.intl.placeholder : entity.intl.introduction,
        template: websiteTemplate,
        thumbConfiguration: {}
    } %}
{% endif %}

{# ---------- 2) DÉTAILS : galerie (gauche) + infos + accordéons + CTA (droite) ---------- #}
<section id="product-view" class="product-detail">
    <div class="container-fluid-right no-overflow">
        <div class="row align-items-start g-0">

            {# Galerie : carousel Bootstrap (fade) + flèches latérales + compteur « 1 / N » #}
            <div class="col-lg-5 product-gallery-col pt-5 px-lg-5">
                {% if entity.medias is not empty %}
                    {% set galleryId = 'carousel-product-gallery' %}
                    <div id="{{ galleryId }}"
                         class="product-gallery-carousel carousel slide carousel-fade mx-4"
                         data-bs-interval="0"
                         data-bs-autoplay="0"
                         data-bs-pause="0"
                         data-component="carousel-bootstrap">
                        <div class="carousel-inner">
                            {% for media in entity.medias %}
                                {% if media.media.filename is defined and media.media.filename %}
                                    <div class="carousel-item{% if loop.first %} active{% endif %}">
                                        {{ media|file({}, {
                                            disableLink: true,
                                            notInBox: true,
                                            class: 'w-100',
                                            lazyLoad: not loop.first,
                                            priority: loop.first ? 'high' : 'low',
                                            screensSizes: {
                                                mobile: {width: 768, height: 720},
                                                tablet: {width: 690, height: 648},
                                                desktop: {width: 690, height: 648}
                                            }
                                        }) }}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                        {% if entity.medias|length > 1 %}
                            <button class="carousel-control-prev product-gallery-arrow" type="button" data-bs-target="#{{ galleryId }}" data-bs-slide="prev" aria-label="{{ "Précédent"|trans }}">
                                <i class="icon-chevron-left"></i>
                            </button>
                            <button class="carousel-control-next product-gallery-arrow" type="button" data-bs-target="#{{ galleryId }}" data-bs-slide="next" aria-label="{{ "Suivant"|trans }}">
                                <i class="icon-chevron-right"></i>
                            </button>
                        {% endif %}
                    </div>
                    {% if entity.medias|length > 1 %}
                        <div class="product-gallery-counter text-center mt-3" data-carousel-counter="{{ galleryId }}" aria-hidden="true">
                            <span data-carousel-current>1</span> / <span data-carousel-total>{{ entity.medias|length }}</span>
                        </div>
                    {% endif %}
                {% endif %}
            </div>

            {# Colonne droite : titre + surface + intro + accordéons + bouton réserver #}
            <div class="col-lg-7 product-info-col pt-4 pt-lg-5 px-0">

                <div class="row border-bottom m-0 pb-5">
                    <div class="col-lg-8 px-3 px-lg-5">
                        <div class="product-info-head">
                            {% if entity.intl.title %}
                                <strong class="product-info-title text-center text-uppercase d-block mb-0">{{ entity.intl.title|raw }}</strong>
                            {% endif %}
                            {% if surfaceValue %}
                                <span class="product-info-surface text-center d-block mt-0 pb-0">{{ surfaceValue|striptags }}</span>
                            {% endif %}
                            {% if entity.intl.introduction %}
                                <p class="product-info-intro mt-5 mb-0">{{ entity.intl.introduction|raw|nl2br }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Accordéons : un par feature (Capacité, Vue, Terrasse, Équipements, Services inclus…). #}
                <div class="row m-0">
                    <div class="col-lg-8 px-3 px-lg-5">
                        {% if featureGroups|length > 0 %}
                            <div class="accordion product-accordion mt-4" id="product-features">
                                {% set idx = 0 %}
                                {% for fname, values in featureGroups %}
                                    {% set idx = idx + 1 %}
                                    {% set collapseId = 'feature-'~idx %}
                                    {% set isFirst = loop.first %}
                                    <div class="accordion-item">
                                        <h3 class="accordion-header">
                                            <button class="accordion-button text-uppercase{% if not isFirst %} collapsed{% endif %}" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#{{ collapseId }}"
                                                    aria-expanded="{{ isFirst ? 'true' : 'false' }}" aria-controls="{{ collapseId }}">
                                                <span class="accordion-label">{{ fname|raw }}</span>
                                                {# Flèche bas maquette (node 516-2270) : SVG inline, couleur via currentColor, tourne à l'ouverture. #}
                                                <svg class="accordion-icon ms-auto" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                    <path d="M12 4L12 20M4 12L12 20L20 12" stroke="currentColor" stroke-width="4"/>
                                                </svg>
                                            </button>
                                        </h3>
                                        <div id="{{ collapseId }}" class="accordion-collapse collapse{% if isFirst %} show{% endif %}" data-bs-parent="#product-features">
                                            <div class="accordion-body px-0 px-md-4 pt-0 pt-md-4">
                                                <ul class="ms-0 product-feature-list">
                                                    {% for label in values %}
                                                        <li>{{ label|striptags }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% elseif entity.intl.body %}
                            <div class="product-info-body mt-4">{{ entity.intl.body|raw }}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="row mx-0 btn-booking-wrap position-relative">
                    <div class="col-12 px-0">
                        <div class="product-cta mt-5">
                            <a href="{{ bookingUrl }}" class="btn btn-primary btn-booking text-uppercase w-100" data-toggle="preloader">
                                {{ "Réserver cette chambre"|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ---------- 3) LES AUTRES CHAMBRES : slider de cards (card-cover) ---------- #}
{% set otherRooms = associatedEntities.list is defined ? associatedEntities.list : [] %}
{% if otherRooms is not empty %}
    <section id="product-other-rooms" class="product-other-rooms py-5 mt-lg-5 text-center">
        <h2 class="other-rooms-title text-uppercase mt-lg-5">{{ "Les autres chambres"|trans }}</h2>
        <span class="other-rooms-script d-block mb-5">{{ "parister"|trans }}</span>
        {# Slider identique au teaser « chambres » de la home (.products-slider-multi-teaser-container). #}
        {% import 'front/'~websiteTemplate~'/actions/catalog/teaser/slider-multi.html.twig' as macroTeaser %}
        {% set teaserItemsPerSlide = 2 %}
        {% set autoplay = 0 %}
        <div class="container-fluid-right">
        <div class="products-slider-multi-teaser-container position-relative">
            <div id="catalog-teaser-other-rooms" class="catalog-teaser splide mt-5 length-{{ otherRooms|length }}"
                 data-items="{{ teaserItemsPerSlide }}"
                 data-lenght="{{ otherRooms|length }}"
                 data-items-medium-pc="{{ teaserItemsPerSlide }}"
                 data-items-mini-pc="{{ teaserItemsPerSlide }}"
                 data-items-tablet="{{ teaserItemsPerSlide }}"
                 data-items-mobile="{{ teaserItemsPerSlide - 1 }}"
                 data-fade="loop"
                 data-scroll="1"
                 data-pause="1"
                 data-autoplay="{{ autoplay }}"
                 data-arrows="1"
                 data-dots="0"
                 data-offset="250"
                 data-offset-medium-pc="50"
                 data-offset-mini-pc="50"
                 data-offset-tablet="50"
                 data-offset-mobile="50"
                 data-counter="0"
                 data-interval="2500">
                <div class="splide__track">
                    {% set arrowsClass = otherRooms|length >= teaserItemsPerSlide ? ' d-lg-none' : '' %}
                    {{ macroTeaser.arrows(website(), autoplay, 'end', 'primary'~arrowsClass, true, 'top') }}
                    <ul class="splide__list{% if otherRooms|length < teaserItemsPerSlide %} d-lg-flex justify-content-lg-center{% endif %}">
                        {% for post in otherRooms %}
                            <li class="splide__slide{% if otherRooms|length == 1 %} ms-3{% endif %}">
                                {% include 'front/'~websiteTemplate~'/actions/catalog/teaser/include/card-cover.html.twig' with {
                                    post: post,
                                    thumbConfiguration: {},
                                    class: teaserItemsPerSlide > 1 ? 'me-4 me-md-5' : null
                                } only %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        </div>
    </section>
{% endif %}
