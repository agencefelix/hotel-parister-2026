{% trans_default_domain 'front_default' %}

{# Card du slider spa (home-spa-services) : image + overlay (titre sans + sous-titre script + « Découvrir »).
   ENTIÈREMENT cliquable → toute la card est un <a> (image sans lien propre, « Découvrir » en texte pour
   éviter un <a> imbriqué). Card dédiée réutilisable (sélectionnée par slug dans splide.html.twig). #}

{% set cardLink = media.intl.link is defined and media.intl.link ? media.intl.link : null %}

<a href="{{ cardLink }}"
   class="card-spa content d-block position-relative{% if slider.itemsPerSlide > 1 %} me-4 me-md-5{% endif %}"
   {% if cardLink %}data-toggle="preloader"{% endif %}
   aria-label="{{ media.intl.title is defined ? media.intl.title|striptags : '' }}">
    <div class="card-spa-media">
        {{ media|file(thumbConfiguration, {
            class: '',
            disableLink: true,
            notInBox: true,
            maxWidth: fileSizes.width is defined ? fileSizes.width : null,
            maxHeight: fileSizes.height is defined ? fileSizes.height : null,
            popupGallery: false,
            fullPopup: false,
            colSize: colSize is defined ? colSize : null
        }) }}
    </div>

    {% if media.intl.title or media.intl.subTitle %}
        <div class="card-spa-content d-flex flex-column align-items-center text-center p-4">
            {% if media.intl.title %}
                <h{{ media.intl.titleForce }} class="title">{{ media.intl.title|raw }}</h{{ media.intl.titleForce }}>
            {% endif %}
            {% if media.intl.subTitle %}
                <span class="sub-title d-block">{{ media.intl.subTitle|raw }}</span>
            {% endif %}
            {# « Découvrir » en texte (la card entière est le lien) #}
            <span class="slider-link text-uppercase mt-4">{{ media.intl.linkLabel ? media.intl.linkLabel : 'Découvrir'|trans }}</span>
        </div>
    {% endif %}
</a>
