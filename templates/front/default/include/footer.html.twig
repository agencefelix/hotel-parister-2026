{% trans_default_domain 'front_default' %}

{% import _self as macro %}

{% set zonePhones = website.infoZones.phones.footer is defined ? website.infoZones.phones.footer : [] %}
{% set zoneEmails = website.infoZones.emails.footer is defined ? website.infoZones.emails.footer : [] %}
{% set gdprActive = 'gdpr'|moduleActive(configuration) or (axeptioActive is defined and axeptioActive) %}
{% set locale = app.request.locale %}

{# Menus footer ADMINISTRABLES, indexés par slug (les clés de MenuService collisionnent sur « footer »). #}
{% set footerMenus = {} %}
{% for code, menu in mainMenus %}
    {% if menu.arguments.isFooter is defined and menu.arguments.isFooter %}
        {% set footerMenus = footerMenus|merge({(menu.arguments.slug): menu.arguments}) %}
    {% endif %}
{% endfor %}

{# Rend un groupe de footer : titre = nom du menu (administrable) + ses liens (niveau 1). #}
{% macro footerGroup(group) %}
    {% if group %}
        {% set links = group.tree.main is defined ? group.tree.main : [] %}
        <div class="footer-group">
            <h2 class="footer-group-title mb-3">{{ group.entity.adminName|raw }}</h2>
            {% if links %}
                <ul class="reset footer-nav">
                    {% for link in links %}
                        {% if link.title and (link.online is not defined or link.online) %}
                            <li class="mb-2">
                                <a class="footer-link text-decoration-none" href="{{ link.link ? link.link : 'javascript:void(0)' }}"
                                   {% if link.linkBlank %}target="_blank"{% else %}data-toggle="preloader"{% endif %}{% if link.linkExternal %} rel="noopener noreferrer"{% endif %}>
                                    {{ link.title|unescape|raw }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{# Bloc marque (label court + logo cliquable). #}
{% macro brand(label, link, image, alt, webpack, websiteTemplate, sizes, extraClass) %}
    <div class="footer-brand text-center text-lg-start">
        <span class="d-block footer-brand-label mb-3">{{ label|trans|raw }}</span>
        <a class="d-inline-block" href="{{ link }}" target="_blank" rel="noopener noreferrer" aria-label="{{ alt|trans|striptags }}">
            {{ asset('build/front/'~websiteTemplate~'/images/'~image, webpack)|file({}, {
                screensSizes: sizes,
                alt: alt|trans|striptags,
                class: "footer-brand-logo"~(extraClass ? ' '~extraClass : '')
            }) }}
        </a>
    </div>
{% endmacro %}

<footer role="contentinfo" id="footer" class="footer position-relative bg-primary text-uppercase">

    <div class="container py-5">

        {# --------- Rangée 1 : 4 menus administrables côte à côte (desktop), 2 colonnes en dessous --------- #}
        <div class="footer-grid footer-menus-grid mb-5 pb-lg-4">
            {{ macro.footerGroup(footerMenus['footer-hotel'] is defined ? footerMenus['footer-hotel'] : null) }}
            {{ macro.footerGroup(footerMenus['footer-utiles'] is defined ? footerMenus['footer-utiles'] : null) }}
            {{ macro.footerGroup(footerMenus['footer-passerelles'] is defined ? footerMenus['footer-passerelles'] : null) }}
            {{ macro.footerGroup(footerMenus['footer-actualites'] is defined ? footerMenus['footer-actualites'] : null) }}
        </div>

        {# --------- Rangée 2 : marques / note / contact, ALIGNÉES sur les colonnes de menus --------- #}
        <div class="footer-grid footer-info-grid">

            {# Colonne 1 : partenaire officiel (Paris je t'aime) #}
            {{ macro.brand("Partenaire<br>officiel 2026", "https://parisjetaime.com/"~locale, "paris-jetaime.png", "Paris je t'aime", webpack, websiteTemplate, {mobile: {width: 70, height: 70}, tablet: {width: 70, height: 70}, desktop: {width: 70, height: 70}}, "footer-brand-logo-paris") }}

            {# Colonne 2 : un hôtel by (Forstyle) #}
            {{ macro.brand("Un hôtel by", "https://www.forstyle-hotels.com/"~locale, "forstyle-logo-white.png", "Forstyle Hotels Collection", webpack, websiteTemplate, {mobile: {width: 128, height: 77}, tablet: {width: 128, height: 77}, desktop: {width: 128, height: 77}}, "footer-brand-logo-forstyle") }}

            {# Colonne 3 : note d'avis #}
            <div class="footer-rating">
                <span class="footer-rating-score d-block">4,7/5</span>
                <span class="footer-rating-label d-block">{{ "Excellent"|trans|raw }}</span>
                <span class="footer-rating-count d-block">{{ "1678 avis"|trans|raw }}</span>
            </div>

            {# Colonne 4 : contact + réseaux sociaux #}
            <div class="footer-right text-center">
                {% for address in website.addresses %}
                    {% set phones = address.phones is not empty ? address.phones : zonePhones %}
                    {% set emails = address.emails is not empty ? address.emails : zoneEmails %}
                    <address class="footer-contact mb-3">
                        {% if address.address %}{{ address.address|raw }}{% if address.zipCode or address.city %}, {% endif %}{% endif %}{% if address.zipCode %}{{ address.zipCode }} {% endif %}{% if address.city %}{{ address.city }}{% endif %}
                        {% if phones is not empty %}<span class="d-block">{% for phone in phones %}{{ phone|phone(website, {icon: false, only_href: true}) }}{% endfor %}</span>{% endif %}
                        {% if emails is not empty %}<span class="d-block">{% for email in emails %}{{ email.email|email(website, {icon: false, only_href: true}) }}{% endfor %}</span>{% endif %}
                    </address>
                {% endfor %}
                {% if website.networks %}
                    <nav class="socials-list d-inline-flex gap-3 mt-2" aria-label="{{ "Navigation des liens sociaux"|trans|striptags }}">
                        {% for name, infos in website.networks %}
                            {% if infos.link and infos.dirname %}
                                {% set label = name|striptags|capitalize~' - '~'nouvelle fenêtre'|trans|striptags %}
                                <span role="button" class="{{ name }} p-0 d-inline-flex js-open-window" data-url="{{ infos.link }}" aria-label="{{ label }}">
                                    <i class="icon-{{ name|lower }}" aria-hidden="true"></i>
                                    <span class="visually-hidden">{{ label }}</span>
                                </span>
                            {% endif %}
                        {% endfor %}
                    </nav>
                {% endif %}
            </div>
        </div>
    </div>

    {# --------- Barre légale (menu ADMINISTRABLE `footer-legal` ; Copyright + Gestion des cookies en dur) --------- #}
    {% set legalMenu = footerMenus['footer-legal'] is defined ? footerMenus['footer-legal'] : null %}
    {% set legalLinks = legalMenu and legalMenu.tree.main is defined ? legalMenu.tree.main : [] %}
    <div id="footer-bottom">
        <div class="container">
            <div class="row align-items-center py-3">
                <div class="col-12 col-lg-8 text-center text-lg-start fw-700 d-lg-flex gap-3">
                    <span>{{ "Copyright"|trans|raw }} {{ "now"|date('Y') }}</span>
                    {% for link in legalLinks %}
                        {% if link.title and (link.online is not defined or link.online) %}
                            <a class="text-white" href="{{ link.link ? link.link : 'javascript:void(0)' }}"
                               {% if link.linkBlank %}target="_blank"{% else %}data-toggle="preloader"{% endif %}{% if link.linkExternal %} rel="noopener noreferrer"{% endif %}>{{ link.title|unescape|raw }}</a>
                        {% endif %}
                    {% endfor %}
                    {# « Gestion des cookies » = rouvre le consentement (JS) : élément spécial, conditionnel. #}
                    {% if axeptioActive is defined and axeptioActive %}
                        <a class="text-white" href="javascript:openAxeptioCookies()" rel="nofollow">{{ "Gestion des cookies"|trans|raw }}</a>
                    {% elseif gdprActive %}
                        <span class="open-gdpr-modal cursor text-white">{{ "Gestion des cookies"|trans|raw }}</span>
                    {% endif %}
                </div>
                {% if not (anonymousTheme is defined and anonymousTheme) %}
                    <div class="col-12 col-lg-4 text-center text-lg-end">
                        <a class="text-white footer-agency" href="{{ "https://www.felix-creation.fr"|trans }}" target="_blank" rel="noopener noreferrer">{{ "Agence Félix"|trans|raw }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

</footer>
