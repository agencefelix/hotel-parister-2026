{% trans_default_domain 'front_default' %}

{% set intl = media.intl is defined ? media.intl : null %}
{% set fullTitle = intl and intl.title is defined ? intl.title|trim : '' %}
{% set subTitle = intl and intl.subTitle is defined and intl.subTitle ? intl.subTitle|trim : '' %}
{# Script = le <span> enregistré dans le titre en DB (stylé via CSS). Un subTitle explicite,
   s'il existe, tient lieu de script (enrobé d'un <span> pour un rendu identique). #}
{% set titleHtml = subTitle ? fullTitle ~ '<span>' ~ subTitle ~ '</span>' : fullTitle %}
{% set targetLink = intl and intl.link is defined ? intl.link : null %}
{% set label = intl and intl.linkLabel is defined and intl.linkLabel ? intl.linkLabel : 'Découvrir'|trans %}
{% set tag = targetLink ? 'a' : 'div' %}
{% set extraClass = class is defined and class ? ' '~class : '' %}
{% set screensSizes = screensSizes is defined ? screensSizes : {
    mobile: {width: 470, height: 600},
    tablet: {width: 470, height: 600},
    desktop: {width: 470, height: 600}
} %}

<{{ tag }} class="card-cover d-block position-relative h-100{{ extraClass }}"
    {%- if targetLink %} href="{{ targetLink }}" data-toggle="preloader"
        {%- if intl.linkBlank is defined and intl.linkBlank %} target="_blank"{% endif %}
        {%- if intl.linkExternal is defined and intl.linkExternal %} rel="noopener noreferrer"{% endif %}
    {%- endif %} aria-label="{{ fullTitle|striptags }}">
    <div class="card-cover-media">
        {{ media|file(thumbConfiguration, {
            class: '',
            disableLink: true,
            notInBox: true,
            screensSizes: thumbConfiguration is empty ? screensSizes : {},
            maxWidth: fileSizes.width is defined ? fileSizes.width : null,
            maxHeight: fileSizes.height is defined ? fileSizes.height : null,
            popupGallery: false,
            fullPopup: false,
            colSize: colSize is defined ? colSize : null
        }) }}
    </div>
    {% if fullTitle %}
        <span class="card-cover-title d-block text-uppercase">{{ titleHtml|raw }}</span>
    {% endif %}
    {% if intl and ((intl.introduction is defined and intl.introduction) or (intl.body is defined and intl.body)) %}
        <div class="card-cover-text">
            {% if intl.introduction is defined and intl.introduction %}<p class="introduction mb-0">{{ intl.introduction|raw|nl2br }}</p>{% endif %}
            {% if intl.body is defined and intl.body %}<div class="body">{{ intl.body|raw }}</div>{% endif %}
        </div>
    {% endif %}
    {% if targetLink %}
        <span class="card-cover-link d-block text-uppercase d-flex align-items-center justify-content-center">
            <span class="card-cover-label text-white">{{ label }}</span>
        </span>
    {% endif %}
</{{ tag }}>
