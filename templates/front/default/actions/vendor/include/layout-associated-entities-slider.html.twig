{% trans_default_domain 'front_default' %}

{% import _self as macro %}
{% import 'front/'~websiteTemplate~'/include/macros/card.html.twig' as macroCard %}

{# Teaser des entités associées (« Découvrez également »).
   Référence unique : le teaser « Derniers événements » de l'accueil — même carte
   (macros/card.html.twig), même gabarit Splide, mêmes flèches. #}

{% set entities = associatedEntities.list %}
{% set itemsPerSlide = itemsPerSlide is defined ? itemsPerSlide : 3 %}
{% set arrows = entities|length > itemsPerSlide %}
{% set autoplay = 0 %}
{% set disabledTitle = disabledTitle is defined ? disabledTitle : false %}
{% set listingTitle = listingTitle is defined and listingTitle ? listingTitle : "Découvrez également"|trans %}

{% macro arrows(side, color) %}
    <div class="arrows-wrap d-flex justify-content-{{ side }} mb-5{% if 'end' == side %} me-4 me-md-5{% endif %} as-btn">
        <button class="btn-arrow btn-prev cursor me-2 btn-circle btn btn-{{ color }}" aria-label="{{ "Précédent"|trans }}" tabindex="-1">
            <i class="icon-chevron-left"></i>
        </button>
        <button class="btn-arrow btn-next cursor ms-2 btn-circle btn btn-{{ color }}" aria-label="{{ "Suivant"|trans }}" tabindex="-1">
            <i class="icon-chevron-right"></i>
        </button>
    </div>
{% endmacro %}

<div class="associated-entities-slider{% if entities is empty %} empty-associated-entities{% endif %}">
    {% if not disabledTitle %}
        {# Même titre que le teaser « Derniers événements » de l'accueil. #}
        <h2 class="title newscast-teaser-title text-uppercase fw-900 text-primary mb-5">{{ listingTitle|raw }}</h2>
    {% endif %}
    <div class="listing-entities-container">
        <div class="newscast-teaser splide length-{{ entities|length }}{% if not arrows %} no-arrows{% endif %}"
             data-items="{{ itemsPerSlide }}"
             data-lenght="{{ entities|length }}"
             data-items-medium-pc="{{ itemsPerSlide }}"
             data-items-mini-pc="{{ itemsPerSlide }}"
             data-items-tablet="{{ itemsPerSlide }}"
             data-items-mobile="1"
             data-fade="loop"
             data-scroll="1"
             data-pause="1"
             data-autoplay="{{ autoplay }}"
             data-arrows="{{ arrows ? 1 : 0 }}"
             data-dots="0"
             {# Marge réservée à droite : elle règle à la fois la largeur des slides
                ((piste - offset) / 3) et la part visible de la 4e carte. #}
             data-offset="50"
             data-offset-medium-pc="50"
             data-offset-mini-pc="50"
             data-offset-tablet="50"
             data-offset-mobile="125"
             data-gap-mobile="1.5rem"
             data-gap-tablet="0rem"
             data-counter="0"
             data-interval="2500">
            <div class="splide__track">
                {% if arrows %}
                    {{ macro.arrows('end', 'primary') }}
                {% endif %}
                <ul class="splide__list">
                    {% for entity in entities %}
                        <li class="splide__slide ps-0 pe-0 ps-md-0 pe-md-4 {% if isMobile() %}col-12{% else %}col-md-4{% endif %}{% if loop.index > itemsPerSlide %} d-none{% endif %}">
                            {# Carte mutualisée avec l'index et le teaser : macros/card.html.twig. #}
                            {{ macroCard.standard({
                                card: 'article',
                                class: 'news-card',
                                entity: entity,
                                intl: entity.intl,
                                media: entity.mainMedia,
                                websiteTemplate: websiteTemplate,
                                thumbPlaceholder: true,
                                mediaWidth: 340,
                                mediaHeight: 435,
                                titleForce: 3,
                                disabledSubTitle: true,
                                disabledIntro: true,
                                disabledBody: true,
                                showDate: false,
                                showCategory: false,
                                showLink: false,
                            }) }}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
