{% trans_default_domain 'front_default' %}

{% set intl = post.intl is defined ? post.intl : null %}
{% set fullTitle = intl and intl.title is defined ? intl.title|trim : '' %}
{% set media = post.mainMedia is defined and post.mainMedia ? post.mainMedia : (intl and intl.mainMedia is defined ? intl.mainMedia : null) %}
{% set targetLink = post.url is defined and post.url ? post.url : (intl and intl.link is defined ? intl.link : null) %}
{% set extraClass = class is defined and class ? ' '~class : '' %}
{% set screensSizes = screensSizes is defined ? screensSizes : {
    mobile: {width: 470, height: 600},
    tablet: {width: 470, height: 600},
    desktop: {width: 470, height: 600}
} %}

<a href="{{ targetLink }}" class="card-cover d-block position-relative h-100{{ extraClass }}"{% if targetLink %} data-toggle="preloader"{% endif %}>
    {% if media %}
        <div class="card-cover-media">
            {{ media|file(thumbConfiguration, {
                screensSizes: thumbConfiguration is empty ? screensSizes : {},
                disableLink: true,
                notInBox: true,
                colSize: colSize is defined ? colSize : 4,
                parentEntity: post.entity is defined ? post.entity : null
            }) }}
        </div>
    {% endif %}
    {# Kicker = texte hors <span> ; script = le <span> enregistré dans le titre en DB (stylé via CSS). #}
    {% if fullTitle %}
        <span class="card-cover-title d-block text-uppercase">{{ fullTitle|raw }}</span>
    {% endif %}
    <span class="card-cover-link d-block text-uppercase d-flex align-items-center justify-content-center">
        <span class="card-cover-label text-white">{{ "Découvrir"|trans }}</span>
    </span>
</a>
