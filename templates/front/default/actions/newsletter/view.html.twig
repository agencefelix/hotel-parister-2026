{% trans_default_domain 'front_default' %}

{% import 'core/webmaster-edit.html.twig' as macroWebmaster %}

{% set customTemplate = 'front/'~websiteTemplate~'/actions/newsletter/template/'~campaign.slug~'.html.twig' %}
{% set customTemplateExist = (customTemplate)|fileExist %}
{% set template = customTemplateExist
    ? 'front/'~websiteTemplate~'/actions/newsletter/template/'~campaign.slug~'.html.twig'
    : 'front/'~websiteTemplate~'/actions/newsletter/template/default.html.twig' %}
{% set intl = campaign|intl %}
{% set intro = intl ? intl.introduction : null %}
{% set modalMessage = intl and intl.placeholder ? intl.placeholder : "Merci pour votre inscription !!"|trans %}
{% set modalId = "newsletter-thanks-modal-"~campaign.id %}
{% set extrenal = "newsletter-thanks-modal-"~campaign.id %}

<div id="newsletter-form-container-{{ campaign.slug }}" class="newsletter-form-container keep-form-module position-relative bg-beige pt-4 pb-5 pt-md-5 pb-md-5{% if campaign.recaptcha %} recaptcha-referer{% endif %}">
    {{ macroWebmaster.box({
        title: "Éditer la campagne"|trans([], 'front_webmaster'),
        role: 'ROLE_NEWSLETTER',
        path: path('admin_campaign_edit', {website: website.id, campaign: campaign.id})
    }) }}
    {% include template %}
</div>
{# Widget Experience Hotel : masqué, alimenté puis soumis par JS après l'enregistrement CMS.
   Volontairement hors de `.newsletter-form-container` : ce conteneur est remplacé à chaque
   envoi AJAX, et un <script> réinjecté via innerHTML ne serait jamais réexécuté. #}
<div id="newsletter-widget-{{ campaign.slug }}" class="newsletter-widget" aria-hidden="true">
    <script data-xp-widget-newsletter-464 src="https://widgets.experience-hotel.com/front/widget/widget-newsletter/bootstrap.js?widget_id=464"></script>
</div>